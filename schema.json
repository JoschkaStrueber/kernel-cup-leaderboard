{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kernel Cup results",
  "description": "What kcup_harness/bench.py writes to results/ (design section 6.5). The collector validates every JSON against it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kit_version", "mode", "round", "started_at", "finished_at", "team", "kernel",
               "harness", "environment", "correctness", "census", "shapes", "summary"],
  "properties": {
    "schema_version": {"const": 1},
    "kit_version": {"type": "string", "pattern": "^v[0-9]+$"},
    "mode": {"enum": ["full", "shape", "final", "comparators"]},
    "round": {"type": ["integer", "null"], "minimum": 1},
    "started_at": {"$ref": "#/$defs/utc"},
    "finished_at": {"$ref": "#/$defs/utc"},
    "team": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nickname", "division", "language"],
      "properties": {
        "nickname": {"type": "string"},
        "division": {"type": "string"},
        "language": {"type": "string"}
      }
    },
    "kernel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "sha256", "head", "uncommitted"],
      "properties": {
        "files": {"$ref": "#/$defs/files", "minProperties": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "head": {"anyOf": [{"$ref": "#/$defs/sha1"}, {"type": "null"}]},
        "uncommitted": {"type": "boolean"}
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "sha256"],
      "properties": {
        "files": {"$ref": "#/$defs/files"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device", "gpu", "gpu_memory_bytes", "sm_count", "l2_bytes", "driver", "sm_clock_mhz",
                   "max_sm_clock_mhz", "max_memory_clock_mhz", "torch", "cuda", "packages", "slurm_job_id", "node",
                   "hostname"],
      "properties": {
        "device": {"type": "string"},
        "gpu": {"type": ["string", "null"]},
        "gpu_memory_bytes": {"type": ["integer", "null"]},
        "sm_count": {"type": ["integer", "null"]},
        "l2_bytes": {"type": ["integer", "null"]},
        "driver": {"type": ["string", "null"]},
        "sm_clock_mhz": {"type": ["integer", "null"]},
        "max_sm_clock_mhz": {"type": ["integer", "null"]},
        "max_memory_clock_mhz": {"type": ["integer", "null"]},
        "torch": {"type": "string"},
        "cuda": {"type": ["string", "null"]},
        "packages": {"type": "object", "additionalProperties": {"type": "string"}},
        "slurm_job_id": {"type": ["string", "null"]},
        "node": {"type": "string"},
        "hostname": {"type": "string"}
      }
    },
    "correctness": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kernel_sha256", "harness_sha256", "scope", "cases", "seed_mode"],
          "properties": {
            "kernel_sha256": {"$ref": "#/$defs/sha256"},
            "harness_sha256": {"$ref": "#/$defs/sha256"},
            "scope": {"type": "string", "pattern": "^(full|[0-9]+,[0-9]+)$"},
            "cases": {"type": "integer", "minimum": 1},
            "seed_mode": {"enum": ["public", "secret"]}
          }
        }
      ]
    },
    "census": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "violations", "kernels_per_call", "calls"],
      "properties": {
        "passed": {"type": "boolean"},
        "violations": {"type": "array", "items": {"type": "string"}},
        "kernels_per_call": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/shape_key"},
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "calls": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/shape_key"},
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ops", "kernels"],
            "properties": {
              "ops": {"type": "array", "items": {"type": "object", "required": ["name", "shapes"]}},
              "kernels": {"type": "array", "items": {"type": "object", "required": ["name", "stream"]}}
            }
          }
        }
      }
    },
    "shapes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/shape"}},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "sol_percent", "full_grid"],
      "properties": {
        "score": {"$ref": "#/$defs/positive"},
        "sol_percent": {"$ref": "#/$defs/positive"},
        "full_grid": {"type": "boolean"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"not": {"const": "comparators"}}}},
      "then": {"properties": {"correctness": {"type": "object"}}}
    }
  ],
  "$defs": {
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "positive": {"type": "number", "exclusiveMinimum": 0},
    "shape_key": {"pattern": "^[0-9]+,[0-9]+$"},
    "files": {
      "type": "object",
      "propertyNames": {"description": "A path relative to the kit root that never climbs out of it.",
                        "pattern": "^(?!/)(?!(.*/)?\\.\\.(/|$)).+$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["blob", "sha256"],
        "properties": {"blob": {"$ref": "#/$defs/sha1"}, "sha256": {"$ref": "#/$defs/sha256"}}
      }
    },
    "impl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["median_s", "spread", "loop_s", "wall_s", "reps", "sm_clock_mhz"],
      "properties": {
        "median_s": {"$ref": "#/$defs/positive"},
        "spread": {"type": "number", "minimum": 0},
        "loop_s": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/positive"}},
        "wall_s": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/positive"}},
        "reps": {"type": "integer", "minimum": 1},
        "sm_clock_mhz": {"type": ["integer", "null"]},
        "check": {"type": "array", "items": {"type": "string"}}
      }
    },
    "impl_error": {
      "description": "A comparator that raised. The reference, copy and the submission or the starter standing in for it never take this form.",
      "type": "object",
      "additionalProperties": false,
      "required": ["error"],
      "properties": {"error": {"type": "string", "minLength": 1}}
    },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n", "v", "buffers", "impls", "speedup", "sol_percent", "copy_bandwidth"],
      "properties": {
        "n": {"type": "integer", "minimum": 1},
        "v": {"type": "integer", "minimum": 1},
        "buffers": {"type": "integer", "minimum": 1},
        "impls": {
          "type": "object",
          "required": ["reference", "copy"],
          "anyOf": [{"required": ["submission"]},
                    {"required": ["starter"], "properties": {"starter": {"$ref": "#/$defs/impl"}}}],
          "properties": {
            "reference": {"$ref": "#/$defs/impl"},
            "copy": {"$ref": "#/$defs/impl"},
            "submission": {"$ref": "#/$defs/impl"}
          },
          "additionalProperties": {"anyOf": [{"$ref": "#/$defs/impl"}, {"$ref": "#/$defs/impl_error"}]}
        },
        "speedup": {"$ref": "#/$defs/positive"},
        "sol_percent": {"$ref": "#/$defs/positive"},
        "copy_bandwidth": {"$ref": "#/$defs/positive"}
      }
    }
  }
}
